---
import "@fontsource/special-elite/latin-400.css";
import "@fontsource/big-shoulders-display/latin-800.css";

// ─────────────────────────────────────────────────────────────
//  PEGA AQUÍ EL ENLACE DEL ENSAYO COMPLETO EN GOOGLE DOCS:
const ENSAYO_URL = "https://docs.google.com/document/d/1XO0N41yVMBvCEesN9t9jcpAYx475kOV5-2zF6ibv3Ys/edit?usp=sharing";
// ─────────────────────────────────────────────────────────────

const laminas = [
  {
    id: "manifiesto",
    folio: "00",
    titulo: "Pregunta orientadora",
    src: "/posters/p0.webp",
    alt: "Portada del zine. Sobre fondo rojo, pregunta orientadora: cómo se manifiestan las relaciones de poder en torno a memoria y violencia a partir de las perspectivas de las fuentes.",
  },
  {
    id: "tesis",
    folio: "01",
    titulo: "Tesis",
    src: "/posters/p1.webp",
    alt: "Panfleto 1, Tesis. Cartel tipográfico con la tesis central y las fuentes primarias y secundarias que sostienen el ensayo visual.",
  },
  {
    id: "cuerpos",
    folio: "02",
    titulo: "Coerción física",
    src: "/posters/p2.webp",
    alt: "Panfleto 2, Coerción física: Los cuerpos reclutados. Linograbado de jóvenes reclutas pobres marchando hacia un cuartel y una cita sobre los ricos que ponen la plata y los pobres que ponen los muertos.",
  },
  {
    id: "tierra",
    folio: "03",
    titulo: "La tierra robada",
    src: "/posters/p3.webp",
    alt: "Panfleto 3, La tierra robada. Collage de recortes tipo cómic sobre Montes de María, el agronegocio, el desplazamiento y el despojo cotidiano.",
  },
  {
    id: "canto",
    folio: "04",
    titulo: "El canto que no calla",
    src: "/posters/p4.webp",
    alt: "Panfleto 4, El canto que no calla. Linograbado de alabaoras cantando junto al río y una cita de alabao como denuncia política.",
  },
  {
    id: "ahora",
    folio: "05",
    titulo: "¿Y ahora qué?",
    src: "/posters/p5.webp",
    alt: "Panfleto 5, ¿Y ahora qué? Conclusión tipográfica: el poder se sostiene a través de la violencia, con síntesis de coerción física, económica y cultural.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Memoria y Violencia · Radiografía de la explotación de las minorías en Colombia</title>
    <meta
      name="description"
      content="Ensayo visual en cinco panfletos sobre la explotación y subordinación de las minorías en Colombia. Eje Memoria y Violencia."
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#15110d" />
  </head>
  <body>
    <a class="saltar" href="#barra">Saltar a la navegación</a>

    <!-- Enlace al ensayo completo, fijo arriba a la izquierda -->
    <a
      class="ensayo"
      href={ENSAYO_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-describedby="ensayo-tip"
    >
      <span class="ensayo__marca" aria-hidden="true">¶</span>
      <span class="ensayo__txt">Ensayo completo</span>
    </a>
    <span id="ensayo-tip" class="ensayo__tip" role="tooltip">
      Abre el ensayo académico completo (texto íntegro con fuentes) en Google Docs, en una pestaña nueva.
    </span>

    <main class="escenario" aria-roledescription="carrusel" aria-label="Zine Memoria y Violencia, seis panfletos">
      <div class="lienzo">
        {laminas.map((l, i) => (
          <figure class="lamina" data-i={i} aria-hidden={i === 0 ? "false" : "true"}>
            <img
              src={l.src}
              alt={l.alt}
              width="1680"
              height="1050"
              decoding="async"
              fetchpriority={i === 0 ? "high" : "auto"}
              draggable="false"
            />
          </figure>
        ))}

        <button class="zona zona--prev" type="button" data-go="prev" aria-label="Panfleto anterior">
          <span class="chev" aria-hidden="true">‹</span>
        </button>
        <button class="zona zona--next" type="button" data-go="next" aria-label="Panfleto siguiente">
          <span class="chev" aria-hidden="true">›</span>
        </button>

        <p class="pista" aria-hidden="true">← → · clic a los lados · desliza</p>
      </div>

      <nav id="barra" class="barra" aria-label="Navegación de panfletos">
        <button class="barra__mover" type="button" data-go="prev" rel="prev">
          <span aria-hidden="true">←</span> <span class="barra__mover-txt">Anterior</span>
        </button>

        <div class="barra__centro">
          <p class="barra__rotulo" aria-hidden="true">
            <span class="barra__folio" data-folio>00</span>
            <span data-titulo>Manifiesto</span>
          </p>
          <ol class="indice" role="tablist" aria-label="Ir a un panfleto">
            {laminas.map((l, i) => (
              <li>
                <button
                  type="button"
                  role="tab"
                  data-jump={i}
                  aria-label={`Panfleto ${l.folio}: ${l.titulo}`}
                  aria-selected={i === 0 ? "true" : "false"}
                ><span>{l.folio}</span></button>
              </li>
            ))}
          </ol>
        </div>

        <button class="barra__mover" type="button" data-go="next" rel="next">
          <span class="barra__mover-txt" data-next-label>Siguiente</span> <span aria-hidden="true">→</span>
        </button>
      </nav>
    </main>

    <p class="vivo" aria-live="polite" role="status"></p>

    <script is:inline define:vars={{ total: laminas.length }}>
      (() => {
        const stage = document.querySelector(".lienzo");
        const laminas = [...document.querySelectorAll(".lamina")];
        const dots = [...document.querySelectorAll("[data-jump]")];
        const folioEl = document.querySelector("[data-folio]");
        const tituloEl = document.querySelector("[data-titulo]");
        const nextLabel = document.querySelector("[data-next-label]");
        const prevBtns = [...document.querySelectorAll('[data-go="prev"]')];
        const vivo = document.querySelector(".vivo");
        const pista = document.querySelector(".pista");
        const folios = dots.map((d) => d.querySelector("span").textContent);
        const titulos = dots.map((d) => d.getAttribute("aria-label").split(": ")[1]);
        const ids = ["manifiesto", "tesis", "cuerpos", "tierra", "canto", "ahora"];
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

        const fromHash = () => {
          const h = decodeURIComponent(location.hash.slice(1));
          const byId = ids.indexOf(h);
          if (byId >= 0) return byId;
          const n = parseInt(h, 10);
          return Number.isFinite(n) && n >= 0 && n < total ? n : 0;
        };

        let idx = fromHash();
        let animando = false;

        const pintar = (n, dir) => {
          laminas.forEach((f, i) => {
            f.classList.remove("activa", "sale-izq", "sale-der", "entra-izq", "entra-der");
            f.setAttribute("aria-hidden", i === n ? "false" : "true");
          });
          const actual = laminas[n];
          actual.classList.add("activa");
          if (!reduce && dir) {
            const prev = laminas[dir === "next" ? n - 1 : n + 1];
            if (prev) prev.classList.add(dir === "next" ? "sale-izq" : "sale-der");
            actual.classList.add(dir === "next" ? "entra-der" : "entra-izq");
            animando = true;
            setTimeout(() => { animando = false; }, 720);
          }
          dots.forEach((d, i) => d.setAttribute("aria-selected", i === n ? "true" : "false"));
          folioEl.textContent = folios[n];
          tituloEl.textContent = titulos[n];
          prevBtns.forEach((b) => b.toggleAttribute("disabled", n === 0));
          nextLabel.textContent = n === total - 1 ? "Volver al inicio" : "Siguiente";
          vivo.textContent = `Panfleto ${folios[n]}, ${titulos[n]}. ${n + 1} de ${total}.`;
          history.replaceState(null, "", "#" + ids[n]);
        };

        const ir = (n, dir) => {
          n = (n + total) % total;
          if (n === idx || animando) return;
          const d = dir || (n > idx ? "next" : "prev");
          idx = n;
          pintar(idx, d);
        };
        const siguiente = () => ir(idx === total - 1 ? 0 : idx + 1, "next");
        const anterior = () => { if (idx > 0) ir(idx - 1, "prev"); };

        document.querySelectorAll('[data-go="next"]').forEach((b) =>
          b.addEventListener("click", siguiente));
        document.querySelectorAll('[data-go="prev"]').forEach((b) =>
          b.addEventListener("click", anterior));
        dots.forEach((d, i) =>
          d.addEventListener("click", () => ir(i, i > idx ? "next" : "prev")));

        addEventListener("keydown", (e) => {
          if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); siguiente(); }
          else if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); anterior(); }
          else if (e.key === "Home") { e.preventDefault(); ir(0, "prev"); }
          else if (e.key === "End") { e.preventDefault(); ir(total - 1, "next"); }
        });

        let x0 = null, y0 = null;
        stage.addEventListener("touchstart", (e) => {
          x0 = e.changedTouches[0].clientX; y0 = e.changedTouches[0].clientY;
        }, { passive: true });
        stage.addEventListener("touchend", (e) => {
          if (x0 == null) return;
          const dx = e.changedTouches[0].clientX - x0;
          const dy = e.changedTouches[0].clientY - y0;
          if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5)
            dx < 0 ? siguiente() : anterior();
          x0 = y0 = null;
        }, { passive: true });

        addEventListener("hashchange", () => ir(fromHash()));

        ["pointerdown", "keydown", "touchstart"].forEach((ev) =>
          addEventListener(ev, () => pista && pista.classList.add("oculta"),
            { passive: true, once: true }));
        setTimeout(() => pista && pista.classList.add("oculta"), 4600);

        // Popup del ensayo: queda visible al menos 5 s tras el hover/foco.
        const ens = document.querySelector(".ensayo");
        const tip = document.querySelector(".ensayo__tip");
        if (ens && tip) {
          let cierre;
          const mostrar = () => { clearTimeout(cierre); tip.classList.add("visible"); };
          const programarCierre = () => {
            clearTimeout(cierre);
            cierre = setTimeout(() => tip.classList.remove("visible"), 5000);
          };
          ens.addEventListener("pointerenter", mostrar);
          ens.addEventListener("focus", mostrar);
          ens.addEventListener("pointerleave", programarCierre);
          ens.addEventListener("blur", programarCierre);
          tip.addEventListener("pointerenter", mostrar);
          tip.addEventListener("pointerleave", programarCierre);
        }

        pintar(idx, null);
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --tinta: oklch(0.205 0.014 55);
    --papel: oklch(0.928 0.013 83);
    --rojo: oklch(0.560 0.205 27);
    --fondo: oklch(0.165 0.012 55);
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --t: 0.72s;
    --barra-h: clamp(3.3rem, 3rem + 2.4vh, 4.6rem);
  }
  * { box-sizing: border-box; margin: 0; }
  html, body { height: 100%; }
  body {
    height: 100dvh;
    background: var(--fondo);
    color: var(--papel);
    font-family: "Special Elite", "Courier New", monospace;
    overflow: hidden;
    overscroll-behavior: none;
    display: flex;
    flex-direction: column;
  }
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.5;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/><feComponentTransfer><feFuncA type='linear' slope='0.5'/></feComponentTransfer></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
  }

  .saltar {
    position: absolute;
    left: -9999px; top: 0;
    z-index: 60;
    background: var(--papel);
    color: var(--tinta);
    padding: 0.7em 1.1em;
  }
  .saltar:focus { left: 0.6rem; top: 0.6rem; }

  /* ── Enlace al ensayo completo (fijo arriba-izquierda) ── */
  .ensayo {
    position: fixed;
    top: clamp(0.7rem, 2vmin, 1.3rem);
    left: clamp(0.7rem, 2vmin, 1.3rem);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.8rem;
    color: var(--papel);
    text-decoration: none;
    font-size: clamp(0.72rem, 0.66rem + 0.35vw, 0.9rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: oklch(0.205 0.014 55 / 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 2px solid oklch(0.928 0.013 83 / 0.5);
    transform: rotate(-2deg);
    transition: transform 0.25s var(--ease-expo), border-color 0.25s, color 0.25s;
  }
  .ensayo__marca {
    font-family: "Big Shoulders Display", system-ui, sans-serif;
    font-weight: 800;
    color: var(--rojo);
    font-size: 1.25em;
    line-height: 1;
  }
  .ensayo:hover, .ensayo:focus-visible {
    transform: rotate(-2deg) scale(1.04);
    border-color: var(--rojo);
    color: var(--papel);
  }
  .ensayo__tip {
    position: fixed;
    top: clamp(3.3rem, 7vmin, 4.4rem);
    left: clamp(0.7rem, 2vmin, 1.3rem);
    z-index: 40;
    max-width: min(78vw, 22rem);
    padding: 0.7rem 0.9rem;
    background: var(--papel);
    color: var(--tinta);
    font-size: 0.82rem;
    line-height: 1.4;
    letter-spacing: 0.01em;
    text-transform: none;
    border-left: 4px solid var(--rojo);
    box-shadow: 0 0.8rem 2rem oklch(0 0 0 / 0.5);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.22s var(--ease-expo), transform 0.22s var(--ease-expo);
  }
  .ensayo:hover ~ .ensayo__tip,
  .ensayo:focus-visible ~ .ensayo__tip,
  .ensayo__tip.visible { opacity: 1; transform: translateY(0); }

  /* ── Escenario: poster (todo visible) + barra fija = un fold ── */
  .escenario {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .lienzo {
    position: relative;
    flex: 1;
    min-height: 0;
    isolation: isolate;
  }
  .lamina {
    position: absolute;
    inset: 0;
    margin: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    will-change: opacity, transform, filter;
  }
  .lamina img {
    /* Unidades de viewport: siempre definidas → la imagen entra
       completa por encima de la barra fija, en un solo fold. */
    --gap: clamp(0.5rem, 1.8vmin, 1.5rem);
    max-width: calc(100vw - 2 * var(--gap));
    max-height: calc(100dvh - var(--barra-h) - 2 * var(--gap));
    width: auto;
    height: auto;
    box-shadow:
      0 0 0 1px oklch(0 0 0 / 0.4),
      0 2rem 4rem -1rem oklch(0 0 0 / 0.7);
    user-select: none;
  }
  .lamina.activa {
    opacity: 1;
    visibility: visible;
    z-index: 2;
    animation: asienta var(--t) var(--ease-expo) both;
  }

  @keyframes asienta {
    0% { filter: none; }
    40% { filter: drop-shadow(6px 4px 0 var(--rojo)) drop-shadow(-4px -2px 0 oklch(0.5 0.13 250)); }
    100% { filter: none; }
  }
  .lamina.entra-der { animation: entra-der var(--t) var(--ease-expo) both; }
  .lamina.entra-izq { animation: entra-izq var(--t) var(--ease-expo) both; }
  @keyframes entra-der {
    0% { opacity: 0; transform: translateX(9%) scale(0.955); filter: blur(3px); }
    38% { filter: drop-shadow(9px 4px 0 var(--rojo)) drop-shadow(-5px -2px 0 oklch(0.5 0.13 250)); }
    100% { opacity: 1; transform: none; filter: none; }
  }
  @keyframes entra-izq {
    0% { opacity: 0; transform: translateX(-9%) scale(0.955); filter: blur(3px); }
    38% { filter: drop-shadow(-9px 4px 0 var(--rojo)) drop-shadow(5px -2px 0 oklch(0.5 0.13 250)); }
    100% { opacity: 1; transform: none; filter: none; }
  }
  .lamina.sale-izq, .lamina.sale-der { opacity: 1; visibility: visible; z-index: 1; }
  .lamina.sale-izq { animation: sale-izq calc(var(--t) * 0.7) var(--ease-expo) both; }
  .lamina.sale-der { animation: sale-der calc(var(--t) * 0.7) var(--ease-expo) both; }
  @keyframes sale-izq { to { opacity: 0; transform: translateX(-7%) scale(0.965); filter: contrast(1.6) blur(2px); } }
  @keyframes sale-der { to { opacity: 0; transform: translateX(7%) scale(0.965); filter: contrast(1.6) blur(2px); } }

  .zona {
    position: absolute;
    top: 0; bottom: 0;
    width: 30%;
    z-index: 4;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    color: var(--papel);
  }
  .zona--prev { left: 0; justify-content: flex-start; }
  .zona--next { right: 0; justify-content: flex-end; }
  .zona[disabled] { pointer-events: none; }
  .zona[disabled] .chev { opacity: 0 !important; }
  .chev {
    font-family: "Big Shoulders Display", system-ui, sans-serif;
    font-size: clamp(2.5rem, 7vmin, 5rem);
    line-height: 1;
    padding: 0 clamp(0.5rem, 2vmin, 1.4rem);
    opacity: 0.22;
    transform: translateX(var(--cx, 0));
    transition: opacity 0.35s var(--ease-expo), transform 0.35s var(--ease-expo);
    text-shadow: 0 0 1.4rem oklch(0 0 0 / 0.85);
  }
  .zona--prev .chev { --cx: -0.35rem; }
  .zona--next .chev { --cx: 0.35rem; }
  .zona:hover .chev, .zona:focus-visible .chev { opacity: 0.9; transform: none; }

  .pista {
    position: absolute;
    left: 50%;
    bottom: clamp(0.9rem, 3.4vmin, 2rem);
    transform: translateX(-50%);
    z-index: 9;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--papel);
    background: oklch(0.16 0.012 55 / 0.95);
    border: 1px solid oklch(0.928 0.013 83 / 0.4);
    padding: 0.55em 1.1em;
    box-shadow: 0 0.6rem 1.6rem oklch(0 0 0 / 0.55);
    transition: opacity 0.8s var(--ease-expo);
    animation: respira 2.8s ease-in-out infinite;
  }
  .pista.oculta { opacity: 0; pointer-events: none; }
  @keyframes respira { 50% { opacity: 0.82; } }

  /* ── Barra funcional: misma posición SIEMPRE, en los 5 panfletos ── */
  .barra {
    flex: 0 0 var(--barra-h);
    height: var(--barra-h);
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    padding: 0 clamp(0.8rem, 3vw, 2rem);
    background: oklch(0.205 0.014 55 / 0.92);
    border-top: 3px solid var(--rojo);
    color: var(--papel);
  }
  .barra > :first-child { justify-self: start; }
  .barra__centro { justify-self: center; }
  .barra > :last-child { justify-self: end; }
  .barra__mover {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--papel);
    font: inherit;
    font-size: clamp(0.7rem, 0.64rem + 0.4vw, 0.9rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.55em 0.7em;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: color 0.18s var(--ease-expo);
  }
  .barra__mover:hover { color: var(--rojo); }
  .barra__mover[disabled] { opacity: 0.3; pointer-events: none; }

  .barra__centro {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2vw, 1.4rem);
    min-width: 0;
  }
  .barra__rotulo {
    display: flex;
    align-items: center;
    gap: 0.5ch;
    font-size: clamp(0.7rem, 0.64rem + 0.4vw, 0.92rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .barra__rotulo span { display: inline-flex; align-items: center; line-height: 1; }
  .barra__folio {
    font-family: "Big Shoulders Display", system-ui, sans-serif;
    font-weight: 800;
    color: var(--rojo);
    font-size: 1.5em;
    line-height: 1;
  }
  .indice { display: flex; gap: clamp(0.35rem, 1.2vw, 0.7rem); list-style: none; padding: 0; }
  .indice button {
    appearance: none;
    width: 1.5rem;
    height: 1.5rem;
    border: 1px solid oklch(0.928 0.013 83 / 0.35);
    background: transparent;
    color: oklch(0.928 0.013 83 / 0.6);
    font-family: "Big Shoulders Display", system-ui, sans-serif;
    font-weight: 800;
    font-size: 0.72rem;
    cursor: pointer;
    transition: transform 0.2s var(--ease-expo), color 0.2s, border-color 0.2s, background 0.2s;
  }
  .indice button:hover { transform: translateY(-2px); color: var(--papel); }
  .indice button[aria-selected="true"] { background: var(--rojo); border-color: var(--rojo); color: var(--papel); }

  .vivo {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  :focus-visible { outline: 3px solid var(--rojo); outline-offset: 3px; }

  @media (max-width: 600px) {
